  "components": {
    "schemas": {
      "AgentHistoryItem": {
        "properties": {
          "role": {
            "type": "string",
            "title": "Role",
            "default": "user"
          },
          "content": {
            "type": "string",
            "title": "Content",
            "default": ""
          }
        },
        "type": "object",
        "title": "AgentHistoryItem",
        "description": "Agent 入口的历史对话（前端把最近几轮带上，便于\"再答一次\"不丢上下文）。"
      },
      "AgentIn": {
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1,
            "title": "Message"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/AgentHistoryItem"
            },
            "type": "array",
            "title": "History"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "AgentIn",
        "description": "P0-1：Agent 入口（**additive**，SPEC 的 12 个端点一个都没动）。\n\n用户只给一句话；Agent 自己决定：建档 / 追问 / 推荐 / 开小测 / 改计划。"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LabActionIn": {
        "properties": {
          "action": {
            "type": "string",
            "title": "Action"
          },
          "question_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Question Id"
          },
          "answer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Answer"
          },
          "feedback": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Feedback"
          },
          "minutes": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 1440.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Minutes"
          }
        },
        "type": "object",
        "required": [
          "action"
        ],
        "title": "LabActionIn",
        "description": "队友实验室 lab.v2 的额外动作透传（additive，SPEC 只要求 start/answer）。"
      },
      "LabAnswerIn": {
        "properties": {
          "question_id": {
            "type": "string",
            "title": "Question Id"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          }
        },
        "type": "object",
        "required": [
          "question_id",
          "answer"
        ],
        "title": "LabAnswerIn"
      },
      "LabStartIn": {
        "properties": {
          "material_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Material Id"
          },
          "topic": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Topic"
          },
          "mode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mode"
          }
        },
        "type": "object",
        "title": "LabStartIn"
      },
      "MaterialIn": {
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "title": "Title"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "title": "Text"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          },
          "is_demo": {
            "type": "boolean",
            "title": "Is Demo",
            "default": false
          },
          "school_id": {
            "anyOf": [
              {
                "type": "string"
              },
